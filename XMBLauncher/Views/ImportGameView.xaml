<Window x:Class="XMBLauncher.Views.ImportGameView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Game"
        Width="700"
        Height="450"
        WindowStartupLocation="CenterOwner"
        Background="#071522"
        Foreground="White">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <TextBlock Text="IMPORT GAME"
                   FontSize="28"
                   FontWeight="Light"
                   Foreground="White"/>



        <StackPanel Grid.Row="1"
                    Margin="0,35,0,20">

            <TextBlock Text="Game executable"
                       FontSize="16"
                       Foreground="#9AB6CC"/>


            <Grid Margin="0,10,0,30">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBox x:Name="ExecutablePathTextBox"
                         Height="40"
                         Padding="10"
                         IsReadOnly="True"
                         Background="#10283C"
                         Foreground="White"
                         BorderBrush="#345A73"/>


                <Button Grid.Column="1"
                        Content="Browse..."
                        Width="110"
                        Height="40"
                        Margin="10,0,0,0"
                        Click="BrowseButton_Click"/>

            </Grid>



            <TextBlock Text="Executable information"
                       FontSize="16"
                       Foreground="#9AB6CC"/>


            <Grid Margin="0,15,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>


                <TextBlock Text="Product"
                           Foreground="#7898B2"/>

                <TextBlock x:Name="ProductNameText"
                           Grid.Column="1"/>


                <TextBlock Text="Company"
                           Grid.Row="1"
                           Foreground="#7898B2"/>

                <TextBlock x:Name="CompanyNameText"
                           Grid.Row="1"
                           Grid.Column="1"/>


                <TextBlock Text="Version"
                           Grid.Row="2"
                           Foreground="#7898B2"/>

                <TextBlock x:Name="VersionText"
                           Grid.Row="2"
                           Grid.Column="1"/>


                <TextBlock Text="Description"
                           Grid.Row="3"
                           Foreground="#7898B2"/>

                <TextBlock x:Name="DescriptionText"
                           Grid.Row="3"
                           Grid.Column="1"/>

            </Grid>

        </StackPanel>



        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="Continue"
                    Width="120"
                    Height="40"
                    Click="ContinueButton_Click"/>

        </StackPanel>

    </Grid>

</Window>